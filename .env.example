# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Admin Authentication
ADMIN_API_KEY=tbrls-admin-dev-secret-key-change-me

# PostgreSQL Database Connection
# Local development default connects to tbrls_dev database on localhost
DATABASE_URL=postgres://localhost:5432/tbrls_dev
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_CONNECTION_TIMEOUT_MS=5000

# Default Policy Settings (for client keys without explicit policies)
DEFAULT_POLICY_TYPE=TOKEN_BUCKET
DEFAULT_BUCKET_CAPACITY=10
DEFAULT_BUCKET_REFILL_RATE=2.0
DEFAULT_WINDOW_LIMIT=60
DEFAULT_WINDOW_DURATION_SECONDS=60
