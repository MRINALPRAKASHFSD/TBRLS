# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Authentication Credentials (LOCAL DEVELOPMENT PLACEHOLDERS ONLY)
# In production (NODE_ENV=production), both keys are strictly required and placeholder values will cause startup failure.
ADMIN_API_KEY=tbrls-admin-dev-secret-key-change-me
CHECK_API_KEY=tbrls-check-dev-secret-key-change-me

# PostgreSQL Database Connection
# Local development default connects to tbrls_dev database on localhost
DATABASE_URL=postgres://localhost:5432/tbrls_dev
# Remote / Supabase connection example:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.kbkchutjljieqavhrviw.supabase.co:5432/postgres
# DATABASE_SSL=true # Automatically enabled for supabase.co hostnames or sslmode=require
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_CONNECTION_TIMEOUT_MS=5000

# Default Policy Settings (for client keys without explicit policies)
DEFAULT_POLICY_TYPE=TOKEN_BUCKET
DEFAULT_BUCKET_CAPACITY=10
DEFAULT_BUCKET_REFILL_RATE=2.0
DEFAULT_WINDOW_LIMIT=60
DEFAULT_WINDOW_DURATION_SECONDS=60
