{
  "name": "tbrls",
  "version": "1.0.0",
  "description": "Beginner-friendly Token Bucket & Sliding Window Rate Limiter Service with PostgreSQL and Fastify",
  "main": "dist/server.js",
  "type": "module",
  "author": "MRINALPRAKASH",
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "migrate": "tsx src/db/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "load-test": "k6 run load-tests/k6-rate-limit.js"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.52",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.7",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
